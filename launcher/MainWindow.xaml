<Window x:Class="ShiyinLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾音启动器" Width="1000" Height="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="#101724" Foreground="#F4F6FA" FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="app-icon.png" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A5B3C8"/>
        <SolidColorBrush x:Key="Line" Color="#303E54"/>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#EAF1FA"/>
            <Setter Property="Background" Value="#1F2C40"/>
            <Setter Property="BorderBrush" Value="#3A4961"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value=".83"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value=".68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value=".40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border Width="1000" Height="620" Background="#101724" BorderBrush="#344259" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#101724" BorderBrush="#273347" BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" Margin="0,23,0,0">
                            <Image Width="39" Height="39" Source="app-icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Margin="12,37,12,0" Height="61" Background="#26374D" BorderBrush="#4A637F"
                                    BorderThickness="1" CornerRadius="13">
                                <StackPanel VerticalAlignment="Center">
                                    <Path Data="M 0,8 L 4,8 7,2 11,15 15,0 19,12 22,8 26,8" Stroke="#95E7D5"
                                          StrokeThickness="1.7" Width="26" Height="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="启动" HorizontalAlignment="Center" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="FolderButton" Click="OpenOutput" Style="{StaticResource ButtonBase}"
                                AutomationProperties.Name="打开输出目录" ToolTip="打开输出目录"
                                VerticalAlignment="Bottom" Width="53" Height="57" Margin="0,0,0,20"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel>
                                <Path Data="M 0,3 L 8,3 10,5 20,5 20,17 0,17 Z" Stroke="#BAC8DA" StrokeThickness="1.5"
                                      Width="21" Height="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="输出" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="486"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid ClipToBounds="True">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,.3" EndPoint="1,.7">
                                <GradientStop Color="#141E30" Offset="0"/>
                                <GradientStop Color="#20334F" Offset=".53"/>
                                <GradientStop Color="#143C47" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Canvas Width="920" Height="486" IsHitTestVisible="False" HorizontalAlignment="Left">
                            <Ellipse Width="680" Height="640" Canvas.Left="307" Canvas.Top="-75" Opacity=".83">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#447BB2" Offset="0"/>
                                        <GradientStop Color="#235775" Offset=".55"/>
                                        <GradientStop Color="#00274152" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path Data="M 391,486 L 798,0 920,0 920,102 602,486 Z" Fill="#194CA9B1"/>
                            <Path Data="M 460,486 L 867,0 M 545,486 L 920,42 M 690,486 L 920,211 M 403,410 L 752,0"
                                  Stroke="#2973B1C1" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="425" Canvas.Top="42" Width="441" Height="410" Stroke="#356DA2B7" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="456" Canvas.Top="63" Width="379" Height="368" Stroke="#5669B2CC" StrokeThickness="1" StrokeDashArray="2 6"/>
                            <Ellipse Canvas.Left="489" Canvas.Top="87" Width="312" Height="320" Stroke="#627CC3D6" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="508" Canvas.Top="105" Width="275" Height="283" Stroke="#316DBED6">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#1941A8AE" Offset="0"/>
                                        <GradientStop Color="#48112139" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path Data="M 460,249 L 828,249 M 645,63 L 645,431 M 490,154 L 798,154 M 490,344 L 798,344"
                                  Stroke="#3779B4C2" StrokeThickness="1" StrokeDashArray="3 5"/>
                            <Ellipse Canvas.Left="643" Canvas.Top="60" Width="6" Height="6" Fill="#9DFFE4"/>
                            <Ellipse Canvas.Left="796" Canvas.Top="149" Width="6" Height="6" Fill="#9DFFE4"/>
                            <Ellipse Canvas.Left="827" Canvas.Top="245" Width="7" Height="7" Fill="#F6C781"/>
                            <Ellipse Canvas.Left="488" Canvas.Top="340" Width="5" Height="5" Fill="#9DFFE4"/>
                            <Canvas x:Name="Waveform" Canvas.Left="457" Canvas.Top="147" Width="377" Height="204"/>
                            <TextBlock Canvas.Left="761" Canvas.Top="365" Text="LOCAL SIGNAL"
                                       FontFamily="Consolas" FontSize="11" Foreground="#A0BBC7"/>
                            <TextBlock Canvas.Left="761" Canvas.Top="383" Text="16 kHz  /  MONO"
                                       FontFamily="Consolas" FontSize="10" Foreground="#94AFC1"/>
                        </Canvas>
                        <Border Background="#04000000" Height="58" VerticalAlignment="Top" MouseLeftButtonDown="DragTitleBar">
                            <Grid Margin="29,0,12,0">
                                <TextBlock Text="拾音启动器" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Click="MinimizeWindow" Style="{StaticResource WindowButton}" Content="−"
                                            ToolTip="最小化" AutomationProperties.Name="最小化"/>
                                    <Button Click="CloseWindow" Style="{StaticResource WindowButton}" Content="×"
                                            ToolTip="关闭启动器" AutomationProperties.Name="关闭启动器" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Margin="49,134,0,0" Width="398" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock Text="S H I Y I N    /    L O C A L  A U D I O" FontFamily="Consolas" FontSize="12"
                                       FontWeight="Bold" Foreground="#92E0CB"/>
                            <TextBlock Text="拾音" FontSize="70" FontWeight="Bold" Margin="-4,8,0,0"/>
                            <TextBlock Text="把声音变成可编辑的文字" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="音频与视频转写 · 文稿与字幕导出" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,13,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <Border CornerRadius="7" Background="#2A4560" Padding="10,5">
                                    <TextBlock Text="本地识别" Foreground="#C6F5E9" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="7" Background="#243750" Padding="10,5" Margin="8,0,0,0">
                                    <TextBlock Text="TXT / SRT / VTT" Foreground="#CDD9EA" FontSize="12" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#151F30" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <Grid Margin="28,13,24,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8796AF" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="StatusText" Text="正在检查服务…" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock x:Name="ModelText" Text="" Foreground="{StaticResource Muted}" FontSize="12"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="HintText" Text="127.0.0.1:18900" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UpdateButton" Click="CheckUpdate" Style="{StaticResource ButtonBase}" Width="92" Height="44"
                                        Content="检查更新" IsEnabled="False" Margin="0,0,11,0"/>
                                <Button x:Name="StopButton" Click="StopService" Style="{StaticResource ButtonBase}" Width="92" Height="44"
                                        Content="停止服务" IsEnabled="False" Margin="0,0,11,0"/>
                                <Button x:Name="LaunchButton" Click="LaunchService" Style="{StaticResource ButtonBase}"
                                        Width="198" Height="56" FontSize="17" Foreground="#202332" BorderBrush="#FFE0A1"
                                        Content="启动拾音   ›" IsEnabled="False">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFE4A4" Offset="0"/>
                                            <GradientStop Color="#F6BB65" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</Window>
