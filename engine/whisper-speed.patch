+template<typename Function>
+static void whisper_run_decoder_workers(int n_threads, const Function & process) {
+    if (n_threads <= 1) {
+        process();
+        return;
+    }
+
+#ifdef _OPENMP
+    // Reuse the OpenMP workers across tokens instead of creating OS threads per token.
+    #pragma omp parallel num_threads(n_threads)
+    {
+        process();
+    }
+#else
+    std::vector<std::thread> threads(n_threads - 1);
+    for (auto & thread : threads) {
+        thread = std::thread(process);
+    }
+    process();
+    for (auto & thread : threads) {
+        thread.join();
+    }
+#endif
+}
